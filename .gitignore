# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite / build artifacts / archives — not part of source control
prisma/dev.db
*.tar.gz
*.zip
tsc_errors.log
src_corrupted_backup/

# one-off ops/deploy scripts with hardcoded live credentials — never commit
get_ip.mjs
setup_ssl.mjs
setup_tunnel.mjs
deploy_ubuntu.mjs
check_remote.mjs
execute_deploy.mjs
