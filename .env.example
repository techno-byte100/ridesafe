# RydeSafe / TrackBuddy Environment Variables Example

# --- Database ---
# SQLite for development: file:./prisma/dev.db
# PostgreSQL for production: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./prisma/dev.db"

# --- Authentication ---
# Generate a secret: openssl rand -base64 32
JWT_SECRET="replace-with-a-secret-key"

# --- Optional External Services ---

# Redis (for live location caching)
# REDIS_URL="redis://localhost:6379"

# Katsana GPS Tracking Integration
# KATSANA_API_KEY=""
# KATSANA_BASE_URL="https://api.katsana.com"

# Bukku Billing Integration
# BUKKU_CLIENT_ID=""
# BUKKU_CLIENT_SECRET=""
# BUKKU_BASE_URL="https://my.bukku.net"

# Firebase / FCM (for push notifications)
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
